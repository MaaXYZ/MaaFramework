{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "definitions": {
        "welcome": {
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                }
            ]
        }
    },
    "properties": {
        "controller": {
            "title": "激活的控制器",
            "type": "object",
            "properties": {
                "name": {
                    "title": "控制器名",
                    "type": "string"
                },
                "type": {
                    "title": "控制器类型",
                    "type": "string",
                    "enum": [
                        "Adb",
                        "Win32",
                        "PlayCover",
                        "Linux"
                    ]
                }
            }
        },
        "adb": {
            "title": "ADB配置",
            "type": "object",
            "properties": {
                "adb_path": {
                    "title": "ADB路径参数",
                    "type": "string"
                },
                "address": {
                    "title": "ADB连接参数",
                    "type": "string"
                },
                "config": {
                    "title": "额外配置参数",
                    "type": "object"
                }
            }
        },
        "win32": {
            "title": "Win32配置",
            "type": "object"
        },
        "playcover": {
            "title": "PlayCover配置",
            "type": "object",
            "properties": {
                "address": {
                    "title": "服务地址",
                    "type": "string"
                },
                "uuid": {
                    "title": "Bundle Identifier",
                    "type": "string"
                }
            }
        },
        "linux": {
            "title": "Linux配置",
            "type": "object",
            "properties": {
                "wlr_socket_path": {
                    "title": "Wayland Socket 路径",
                    "type": "string"
                },
                "uinput_screen_width": {
                    "title": "UInput 屏幕宽度（像素）",
                    "type": "integer"
                },
                "uinput_screen_height": {
                    "title": "UInput 屏幕高度（像素）",
                    "type": "integer"
                },
                "eis_socket_path": {
                    "title": "EIS socket 路径",
                    "type": "string"
                }
            }
        },
        "resource": {
            "title": "激活的资源",
            "type": "string"
        },
        "task": {
            "title": "激活的任务",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "title": "任务名",
                        "type": "string"
                    },
                    "option": {
                        "title": "任务选项",
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "title": "选项名",
                                    "type": "string"
                                },
                                "value": {
                                    "title": "选项值",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "name",
                                "value"
                            ]
                        }
                    }
                },
                "required": [
                    "name"
                ]
            }
        },
        "last_welcome": {
            "title": "上次显示的公告声明",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/definitions/welcome"
                }
            ]
        },
        "last_resolved_welcome": {
            "title": "上次显示的公告内容",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/definitions/welcome"
                }
            ]
        },
        "ios": {
            "type": "object",
            "title": "iOS 用户配置",
            "properties": {
                "udid": {
                    "type": "string"
                },
                "wifi": {
                    "type": "string"
                },
                "screencap": {
                    "type": "string"
                },
                "prepare_ddi": {
                    "type": "boolean",
                    "default": true,
                    "description": "运行前自动准备 DDI；关闭时由调用方保证设备已准备好"
                },
                "ddi_cache_directory": {
                    "type": "string",
                    "default": "",
                    "description": "DDI 持久缓存的绝对路径；留空使用当前用户的平台缓存目录"
                },
                "ddi_download_timeout_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600,
                    "default": 300
                },
                "pairing_records": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "直接保存在 PiCli 配置中的不透明配对凭据"
                }
            },
            "additionalProperties": false
        }
    },
    "required": [
        "controller",
        "resource",
        "task"
    ]
}
