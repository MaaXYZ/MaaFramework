{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MaaFramework NeuralNetworkDetector model descriptor",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "input_protocol",
        "output_protocol"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "input_protocol": {
            "$ref": "#/$defs/InputProtocol"
        },
        "output_protocol": {
            "$ref": "#/$defs/OutputProtocol"
        },
        "labels": {
            "oneOf": [
                {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                        "pattern": "^(0|[1-9][0-9]*)$"
                    },
                    "additionalProperties": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            ]
        },
        "producer": {
            "type": "object"
        },
        "nms": {
            "enum": [
                "None",
                "ClassAwareIoU",
                "CandidateCoverage"
            ]
        },
        "nms_threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "output_protocol": {
                        "properties": {
                            "type": {
                                "const": "DetrPacked"
                            },
                            "layout": {
                                "const": "Split"
                            }
                        },
                        "required": [
                            "type",
                            "layout"
                        ]
                    }
                }
            },
            "then": {
                "properties": {
                    "input_protocol": {
                        "required": [
                            "original_size"
                        ]
                    }
                }
            },
            "else": {
                "properties": {
                    "input_protocol": {
                        "not": {
                            "required": [
                                "original_size"
                            ]
                        }
                    }
                }
            }
        }
    ],
    "$defs": {
        "PositiveSize": {
            "type": "array",
            "prefixItems": [
                {
                    "type": "integer",
                    "minimum": 1
                },
                {
                    "type": "integer",
                    "minimum": 1
                }
            ],
            "items": false
        },
        "OriginalSize": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "input_name",
                "order"
            ],
            "properties": {
                "input_name": {
                    "type": "string",
                    "minLength": 1
                },
                "order": {
                    "enum": [
                        "HW",
                        "WH"
                    ]
                }
            }
        },
        "InputProtocol": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "input_name"
            ],
            "properties": {
                "type": {
                    "enum": [
                        "UltralyticsLetterbox",
                        "DirectResizeDivide255",
                        "DirectResizeImageNet"
                    ]
                },
                "input_name": {
                    "type": "string",
                    "minLength": 1
                },
                "size": {
                    "$ref": "#/$defs/PositiveSize"
                },
                "original_size": {
                    "$ref": "#/$defs/OriginalSize"
                }
            }
        },
        "OutputProtocol": {
            "oneOf": [
                {
                    "$ref": "#/$defs/YoloDense"
                },
                {
                    "$ref": "#/$defs/YoloEndToEnd"
                },
                {
                    "$ref": "#/$defs/DetrQueries"
                },
                {
                    "$ref": "#/$defs/DetrPackedInterleaved"
                },
                {
                    "$ref": "#/$defs/DetrPackedSplit"
                }
            ]
        },
        "YoloDense": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "layout"
            ],
            "properties": {
                "type": {
                    "const": "YoloDense"
                },
                "layout": {
                    "enum": [
                        "ChannelsFirst",
                        "ChannelsLast"
                    ]
                },
                "output_name": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "YoloEndToEnd": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type"
            ],
            "properties": {
                "type": {
                    "const": "YoloEndToEnd"
                },
                "output_name": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "DetrQueries": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "boxes",
                "logits",
                "activation"
            ],
            "properties": {
                "type": {
                    "const": "DetrQueries"
                },
                "boxes": {
                    "type": "string",
                    "minLength": 1
                },
                "logits": {
                    "type": "string",
                    "minLength": 1
                },
                "activation": {
                    "enum": [
                        "Sigmoid",
                        "SoftmaxWithNoObject"
                    ]
                },
                "top_k": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 300
                }
            }
        },
        "DetrPackedInterleaved": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "layout"
            ],
            "properties": {
                "type": {
                    "const": "DetrPacked"
                },
                "layout": {
                    "const": "Interleaved"
                },
                "output_name": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "DetrPackedSplit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "layout",
                "labels",
                "boxes",
                "scores"
            ],
            "properties": {
                "type": {
                    "const": "DetrPacked"
                },
                "layout": {
                    "const": "Split"
                },
                "labels": {
                    "type": "string",
                    "minLength": 1
                },
                "boxes": {
                    "type": "string",
                    "minLength": 1
                },
                "scores": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}
