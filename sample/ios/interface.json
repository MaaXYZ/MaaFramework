{
    "interface_version": 2,
    "name": "MaaFramework iOS sample",
    "controller": [
        {
            "name": "iOS",
            "type": "IOS",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "iOS sample",
